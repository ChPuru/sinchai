# Everything here is optional in development. Copy to .env (git ignores .env) to override a value.
#
# JWT_SECRET and SUPERVISOR_CODE are NOT hardcoded anywhere: the first time the server starts it generates random ones
# and appends them to .env. `npm run supervisor-code` prints the supervisor code.
#
# PRODUCTION (names only here - the values go into the host's dashboard, never into git):
#   NODE_ENV=production   MONGO_URI   JWT_SECRET   SUPERVISOR_CODE   CLIENT_ORIGIN
# PORT is set by the host. In production the server also trusts one proxy hop (see config.js: trustProxy).

# development | production | test. production refuses to start without JWT_SECRET and does not generate secrets.
NODE_ENV=development

PORT=3000
# production: the Atlas connection string, with the database name in it (for example .../sinchai?retryWrites=true&w=majority)
MONGO_URI=mongodb://127.0.0.1:27017/sinchai

# REQUIRED when NODE_ENV=production, at least 48 random bytes (generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# origin of the React app (CORS + links in the HTML pages). production: the exact URL of the deployed client,
# with https:// and WITHOUT a trailing slash, e.g. https://your-client.example
CLIENT_ORIGIN=http://localhost:5173

# Access code a person must enter to register as a Field Supervisor (supervisors can see every farmer's plots).
# In production there is no generated value: leave it empty to switch supervisor sign-up off.
SUPERVISOR_CODE=

# OPTIONAL. Where the free Open-Meteo forecast API is reached (default https://api.open-meteo.com, leave unset normally).
# Open-Meteo limits its free tier per IP address, so on a shared host the address can be over the limit and answer HTTP 429
# ("Open-Meteo answered 429" in the log). Set this to the https:// address of a relay that forwards /v1/forecast to Open-Meteo
# from its own address, with no trailing slash. The weather is still Open-Meteo's, unchanged.
# OPEN_METEO_URL=
