# Everything here is optional in development. Copy to .env (git ignores .env) to override a value.
#
# JWT_SECRET and SUPERVISOR_CODE are NOT hardcoded anywhere: the first time the server starts it generates random ones
# and appends them to .env. `npm run supervisor-code` prints the supervisor code.

PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/sinchai

# REQUIRED when NODE_ENV=production (generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# origin of the React app (CORS + links in the HTML pages)
CLIENT_ORIGIN=http://localhost:5173

# Access code a person must enter to register as a Field Supervisor (supervisors can see every farmer's plots).
# In production there is no generated value: leave it empty to switch supervisor sign-up off.
SUPERVISOR_CODE=
