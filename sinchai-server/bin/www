#!/usr/bin/env node

/**
 * Module dependencies.
 */

var config = require('../config');
var app = require('../app');
var db = require('../db');
var daily = require('../jobs/daily');
var debug = require('debug')('sinchai-server:server');
var http = require('http');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(config.port);
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

// Exp 5 - connect to MongoDB first; the server only starts listening once the database is reachable
db.connect()
  .then(function () {
    console.log('MongoDB connected: ' + config.mongoUri);
    server.listen(port);
    daily.start();
  })
  .catch(function (err) {
    console.error('MongoDB connection failed: ' + err.message);
    console.error('Is the MongoDB service running? (Windows: services.msc -> MongoDB, or `net start MongoDB`)');
    process.exit(1);
  });
server.on('error', onError);
server.on('listening', onListening);

// close cleanly on Ctrl + C
process.on('SIGINT', function () {
  server.close();
  db.disconnect().finally(function () {
    process.exit(0);
  });
});

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
  console.log('Server running on http://localhost:' + addr.port);
}
