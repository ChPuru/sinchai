{
  "info": {
    "name": "SinchAI API (Exp 5)",
    "description": "Nothing is pre-loaded: \"1. Auth > Register a farmer\" creates a fresh account every run, \"Login\" stores the JWT in {{token}}, and the folders then run in order (or use the Collection Runner).\nFolder 4 registers a field supervisor and needs the access code: run `npm run supervisor-code` in sinchai-server and paste it into the collection variable `supervisorCode`.\nThe weather requests need live internet (Open-Meteo); when it cannot be reached they answer 503 - the API never invents weather.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "password",
      "value": "Postman@1234"
    },
    {
      "key": "supervisorCode",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "mobile",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "supMobile",
      "value": ""
    },
    {
      "key": "plotName",
      "value": ""
    },
    {
      "key": "plotId",
      "value": ""
    },
    {
      "key": "logId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register - invalid (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"x\",\n  \"email\": \"bad\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Register a farmer (201) - stores {{token}}",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Date.now().toString();",
                  "pm.collectionVariables.set(\"mobile\", \"9\" + n.slice(-9));",
                  "pm.collectionVariables.set(\"email\", \"postman\" + n + \"@example.com\");",
                  "pm.collectionVariables.set(\"supMobile\", \"8\" + n.slice(-9));",
                  "pm.collectionVariables.set(\"plotName\", \"Postman plot \" + n.slice(-5));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Farmer\",\n  \"email\": \"{{email}}\",\n  \"mobile\": \"{{mobile}}\",\n  \"village\": \"Karad\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
