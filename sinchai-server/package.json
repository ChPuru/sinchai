{
  "name": "sinchai-server",
  "version": "1.0.0",
  "private": true,
  "description": "SinchAI API - Express + MongoDB (Mongoose). Experiments 4.1, 4.2 and 5.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node ./bin/www",
    "dev": "node --watch ./bin/www",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "demo": "node scripts/demo-endpoints.js",
    "exp4.1": "node exp4.1-node-basics/run-all.js",
    "exp4.1:servers": "node exp4.1-node-basics/check-servers.js",
    "supervisor-code": "node scripts/supervisor-code.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1"
  }
}
